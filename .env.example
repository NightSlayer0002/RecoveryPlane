# pnpm dev explicitly defaults to demo mode on loopback.
# pnpm start defaults to secure pilot mode; provision ACCESS_TOKENS_JSON first.
DEMO_MODE=false
HOST=127.0.0.1
PORT=3000
DEMO_PORT=3001
# Omit DATABASE_URL to persist embedded PostgreSQL in .data/recoveryplane.
# DATABASE_URL=postgresql://recoveryplane:change-me@127.0.0.1:5432/recoveryplane
# Run pnpm token:create; copy the generated JSON here, never the raw token.
ACCESS_TOKENS_JSON=[]
# DISPATCHER_ENABLED=false enables an independently deployed worker with PostgreSQL.
DISPATCHER_ENABLED=true
